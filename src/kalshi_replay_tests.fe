use ingot::{ForecastLens, ForecastLensMsg}
use ingot::kalshi_fixture::{KALSHI_EVENT_COUNT, KALSHI_EVENTS}
use std::evm::Evm

// Each compressed event carries its unique market-close timestamp as an ID.
#[test]
fn replays_real_kalshi_markets_through_contract() uses (evm: mut Evm) {
    let lens = evm.create2<ForecastLens>(value: Wei::zero(), args: (), salt: 96)
    var i: usize = 0
    var replayed: u256 = 0
    while replayed < KALSHI_EVENT_COUNT {
        let event = KALSHI_EVENTS[i]
        let event_id = event / 2000002
        let code = event % 2000002
        let probability = code / 2
        let outcome = code % 2 == 1
        let _: u256 = evm
            .call(
                addr: lens,
                gas: 3000000,
                value: Wei::zero(),
                message: ForecastLensMsg::Record { event_id, probability, outcome },
            )
        replayed += 1
        i += 1
    }
    assert!(replayed == KALSHI_EVENT_COUNT)

    let (count, brier): (u256, u256) = evm
        .call(
            addr: lens,
            gas: 2000000,
            value: Wei::zero(),
            message: ForecastLensMsg::Scores {},
        )
    assert!(count == KALSHI_EVENT_COUNT)
    assert!(brier == 105328)

    let low: (u256, u256, u256, u256, u256) = evm
        .call(
            addr: lens,
            gas: 2000000,
            value: Wei::zero(),
            message: ForecastLensMsg::BinView { index: 0 },
        )
    assert!(low == (29, 76034, 34483, 6113, 171759))

    let middle: (u256, u256, u256, u256, u256) = evm
        .call(
            addr: lens,
            gas: 2000000,
            value: Wei::zero(),
            message: ForecastLensMsg::BinView { index: 2 },
        )
    assert!(middle == (3, 476667, 666667, 207654, 938510))

    let high: (u256, u256, u256, u256, u256) = evm
        .call(
            addr: lens,
            gas: 2000000,
            value: Wei::zero(),
            message: ForecastLensMsg::BinView { index: 4 },
        )
    assert!(high == (35, 922086, 942857, 813926, 984188))
    let (audit_count, hash): (u256, u256) = evm
        .call(
            addr: lens,
            gas: 2000000,
            value: Wei::zero(),
            message: ForecastLensMsg::Audit {},
        )
    assert!(audit_count == KALSHI_EVENT_COUNT && hash != 0)
}
