use ingot::reliability::Bin
use ingot::scoring::{Brier, Ledger, ScoringRule}
use std::abi::sol
use std::evm::keccak_words

const COUNT_MASK: u256 = 18446744073709551615

pub msg ForecastLensMsg {
    #[selector = sol("record(uint256,uint256,bool)")]
    Record { event_id: u256, probability: u256, outcome: bool } -> u256,

    #[selector = sol("scores()")]
    Scores -> (u256, u256),

    #[selector = sol("bin(uint256)")]
    BinView { index: u256 } -> (u256, u256, u256, u256, u256),

    #[selector = sol("audit()")]
    Audit -> (u256, u256),
}

/// Eight storage words: reporter, rolling hash, Brier ledger and five bins.
/// The second proper rule stays in the pure generic library. Persisting it
/// would add one SSTORE to every forecast without improving calibration.
pub struct ForecastStore { score: u256, b0: u256, b1: u256, b2: u256, b3: u256, b4: u256 }

fn pack_score(_ count: u256, _ brier_sum: u256) -> u256 {
    assert!(count <= COUNT_MASK)
    count | (brier_sum << 64)
}

fn score_parts(_ packed: u256) -> (u256, u256) {
    (packed & COUNT_MASK, packed >> 64)
}

// Bin layout: low 64 bits count, next 64 positives, high 128 probability sum.
fn pack_bin(_ count: u256, _ probability_sum: u256, _ positives: u256) -> u256 {
    assert!(count <= COUNT_MASK)
    assert!(positives <= count)
    assert!(probability_sum <= count * 1000000)
    count | (positives << 64) | (probability_sum << 128)
}

fn bin_parts(_ packed: u256) -> (u256, u256, u256) {
    let count = packed & COUNT_MASK
    let positives = (packed >> 64) & COUNT_MASK
    let probability_sum = packed >> 128
    (count, probability_sum, positives)
}

fn add_bin(_ packed: u256, _ probability: u256, _ outcome: bool) -> u256 {
    let (count, probability_sum, positives) = bin_parts(packed)
    let next_positives = positives + if outcome { 1 } else { 0 }
    pack_bin(count + 1, probability_sum + probability, next_positives)
}

fn record_store(_ probability: u256, _ outcome: bool) -> u256
uses (store: mut ForecastStore)
{
    assert!(probability <= 1000000)
    let (count, brier_sum) = score_parts(store.score)
    assert!(count < COUNT_MASK)
    store.score = pack_score(
        count + 1,
        brier_sum + Brier::loss_numerator(probability, outcome),
    )

    if probability < 200000 {
        store.b0 = add_bin(store.b0, probability, outcome)
    } else if probability < 400000 {
        store.b1 = add_bin(store.b1, probability, outcome)
    } else if probability < 600000 {
        store.b2 = add_bin(store.b2, probability, outcome)
    } else if probability < 800000 {
        store.b3 = add_bin(store.b3, probability, outcome)
    } else {
        store.b4 = add_bin(store.b4, probability, outcome)
    }
    count + 1
}

fn brier_score() -> (u256, u256) uses (store: ForecastStore) {
    let (count, brier_sum) = score_parts(store.score)
    let ledger = Ledger::from_parts(Brier {}, count, brier_sum)
    (count, ledger.score_micro())
}

fn bin_view(_ index: u256) -> (u256, u256, u256, u256, u256)
uses (store: ForecastStore)
{
    assert!(index < 5)
    let packed = if index == 0 {
        store.b0
    } else if index == 1 {
        store.b1
    } else if index == 2 {
        store.b2
    } else if index == 3 { store.b3 } else { store.b4 }
    let (count, probability_sum, positives) = bin_parts(packed)
    Bin::from_parts(count, probability_sum, positives).snapshot()
}

pub contract ForecastLens uses (ctx: Ctx) {
    reporter: Address,
    mut chain: u256,
    mut store: ForecastStore,

    init()
    uses (ctx, mut reporter, mut chain)
    {
        reporter = ctx.caller()
        chain = 0
    }

    recv ForecastLensMsg {
        Record { event_id, probability, outcome } -> u256
        uses (ctx, reporter, mut store, mut chain)
        {
            assert!(ctx.caller() == reporter, "Only the reporter may record")
            assert!(event_id > 0, "Event ID must be nonzero")
            let count = record_store(probability, outcome)
            let outcome_word: u256 = if outcome { 1 } else { 0 }
            chain = keccak_words([chain, event_id, probability, outcome_word])
            count
        }

        Scores -> (u256, u256) uses (store) {
            brier_score()
        }

        BinView { index } -> (u256, u256, u256, u256, u256)
        uses (store)
        {
            bin_view(index)
        }

        Audit -> (u256, u256) uses (store, chain) {
            let (count, _) = score_parts(store.score)
            (count, chain)
        }
    }
}
